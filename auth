# auth.py
import streamlit as st

# Simple hard-coded user store. Replace with database or encrypted store for production.
USERS = {
    "admin": "admin123",
    "ibrahim": "pass123",
    "rbi_user": "securepass"
}

def login():
    """Show login form. On success, set session_state.logged_in and username."""
    st.title("🔐 Login — Monetary Policy Dashboard")
    st.write("Enter your username and password to access the dashboard.")
    username = st.text_input("Username")
    password = st.text_input("Password", type="password")

    col1, col2 = st.columns([1, 1])
    with col1:
        login_btn = st.button("Login")
    with col2:
        st.write("")  # keep layout alignment

    if login_btn:
        if username in USERS and USERS[username] == password:
            st.session_state["logged_in"] = True
            st.session_state["username"] = username
            st.success("Login successful — redirecting...")
            st.experimental_rerun()
        else:
            st.error("Invalid username or password")

def require_login():
    """Stops execution and shows login if user not logged in."""
    if "logged_in" not in st.session_state or not st.session_state["logged_in"]:
        login()
        st.stop()

def logout_button():
    """Place a logout button anywhere (sidebar recommended)."""
    if st.button("Logout"):
        st.session_state["logged_in"] = False
        if "username" in st.session_state:
            del st.session_state["username"]
        st.experimental_rerun()
